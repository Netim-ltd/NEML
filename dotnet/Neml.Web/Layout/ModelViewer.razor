    private async Task SavePartAsync()
    {
        saving = true;
        partMessage = null;
        try
        {
            var changed = picked!.Params.Where(q => Math.Abs(editParams[q.Name] - q.Value) > 1e-9).ToDictionary(q => q.Name, q => editParams[q.Name]);
            var accepted = await Api.PartModelAsync(GenomeId, picked.Id,
                editPos.SequenceEqual(picked.Pos) ? null : editPos,
                picked.Proxy && !editSize.SequenceEqual(picked.BoxSize) ? editSize : null,
                changed.Count > 0 ? changed : null);
            for (var i = 0; i < 120; i++)
            {
                await Task.Delay(1000);
                var status = await Api.GetCommandAsync(accepted!.CommandId);
                if (status is null || status.State is "pending" or "delivered") { continue; }
                var result = status.Result;
                partMessage = status.State == "applied" && result is { ValueKind: JsonValueKind.Object } r && r.TryGetProperty("reply", out var reply)
                    ? reply.GetString()
                    : "Yapamadım: " + (status.Result is { ValueKind: JsonValueKind.Object } e && e.TryGetProperty("error", out var err) ? err.GetString() : status.State);
                if (result is { ValueKind: JsonValueKind.Object } d && d.TryGetProperty("draft", out var draft) && draft.ValueKind == JsonValueKind.Object)
                {
                    await OnDraft.InvokeAsync(draft.GetProperty("id").GetString());
                }

                return;
            }

            partMessage = "Cevap gelmedi; lab meşgul olabilir.";
        }
        catch (HttpRequestException)
        {
            partMessage = "İstek gönderilemedi.";
        }
        finally
        {
            saving = false;
        }
    }

    private string Name => Scene.GetProperty("genome").GetString()!.Replace('@', '_');

    private Task ExportAllAsync() => module!.InvokeVoidAsync("exportStl", $"{Name}.stl").AsTask();

