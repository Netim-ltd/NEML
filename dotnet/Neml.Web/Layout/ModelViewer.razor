    private Task ExportBomAsync()
    {
        var csv = new StringBuilder("﻿Grup;Parça;Adet;Özellik;Teknik özellikler;Bağlantılar;Tahmini\n");
        foreach (var row in Scene.GetProperty("bom").EnumerateArray())
        {
            string F(string text) => "\"" + text.Replace("\"", "\"\"") + "\"";
            var specs = string.Join(" | ", row.GetProperty("specs").EnumerateArray().Select(x => x.GetString()));
            var links = string.Join(" | ", row.GetProperty("links").EnumerateArray().Select(x => x.GetProperty("url").GetString()));
            csv.Append($"{F(row.GetProperty("group").GetString()!)};{F(row.GetProperty("part").GetString()!)};{row.GetProperty("qty").GetInt32()};{F(row.GetProperty("spec").GetString()!)};{F(specs)};{F(links)};{(row.GetProperty("estimated").GetBoolean() ? "evet" : "hayır")}\n");
        }

        return module!.InvokeVoidAsync("downloadText", $"{Name}-malzeme.csv", csv.ToString(), "text/csv").AsTask();
    }

    [JSInvokable]
    public void OnPartPicked(string? id, double[] size)
    {
        picked = null;
        if (id is not null)
        {
            foreach (var part in Scene.GetProperty("parts").EnumerateArray())
            {
                if (part.GetProperty("id").GetString() != id)
                {
                    continue;
                }

                var info = part.GetProperty("info");
                string? stl = null, step = null, drawing = null, dxf = null;
                if (part.TryGetProperty("files", out var files))
                {
                    drawing = files.TryGetProperty("drawing", out var d1) ? d1.GetString() : null;
                    dxf = files.TryGetProperty("dxf", out var d2) ? d2.GetString() : null;
                    stl = files.TryGetProperty("stl", out var a) ? a.GetString() : null;
                    step = files.TryGetProperty("step", out var b) ? b.GetString() : null;
                }

                var pos = part.GetProperty("pos").EnumerateArray().Select(v => v.GetDouble()).ToArray();
                var box = part.GetProperty("geom").GetProperty("size").EnumerateArray().Select(v => v.GetDouble()).ToArray();
                var prms = part.TryGetProperty("params", out var plist)
                    ? plist.EnumerateArray().Select(q => new Prm(q.GetProperty("name").GetString()!, q.GetProperty("value").GetDouble(),
                        q.GetProperty("min").ValueKind == JsonValueKind.Number ? q.GetProperty("min").GetDouble() : null,
                        q.GetProperty("max").ValueKind == JsonValueKind.Number ? q.GetProperty("max").GetDouble() : null)).ToArray()
                    : [];
                picked = new Picked(id, part.GetProperty("label").GetString()!, part.GetProperty("group").GetString()!,
                    info.TryGetProperty("proxy", out var proxy) && proxy.ValueKind == JsonValueKind.True,
                    info.EnumerateObject().Where(p => p.Name != "proxy").ToDictionary(p => p.Name, p => p.Value.ToString()),
                    size, stl, step, pos, box, prms, drawing, dxf);
                editPos = [.. pos];
                editSize = [.. box];
                editParams.Clear();
                foreach (var q in prms) { editParams[q.Name] = q.Value; }
                partMessage = null;
                break;
            }
        }

        Assistant.PickedPart = picked is null ? null : $"{picked.Label} ({picked.Id})";
        Assistant.Notify();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        self?.Dispose();
    }
