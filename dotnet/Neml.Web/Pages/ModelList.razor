@page "/evrim"
@inject ApiClient Api
@inject AssistantState Assistant

<PageTitle>Modeller ve robotlar — NEML</PageTitle>

<PageHeader Title="Modeller ve robotlar" Help="Labın tasarladığı robotlar ve parçalar. Birini aç: 3B görünüm, malzeme listesi ve yapım paketi orada." />
<p class="muted">
    Her robot modelinin kendi tasarımı, evrimi ve eğitimi vardır. Bir modeli seç: 3B tasarımını ve iç aksamını incele,
    montaj/patlatma animasyonunu izle, o model için yapılan evrim ve simülasyon adımlarına bak.
</p>

<p>
    <button class="primary" @onclick='() => Open("new_model")'>Yeni robot tasarla (asistanla)</button>
    <button class="primary" @onclick='() => Open("import")'>GitHub'dan robot / kart içe aktar</button>
</p>

<h2>Hazır şablonlar</h2>
<p class="muted">Tek tıkla lab bu talebi tasarlar (parça ağacı, CAD, URDF, denetim). İlerlemeyi Öğrenme sayfasında görürsün.</p>
<div class="grid">
    @foreach (var (title, brief) in Templates)
    {
        <article class="card">
            <header><h3>@title</h3></header>
            <p class="muted">@brief</p>
            <button class="primary" disabled="@(busyModel == title)" @onclick="() => CreateAsync(title, brief)">Oluştur</button>
        </article>
    }
</div>
@if (created is not null) { <p class="state">@created</p> }

@if (error is not null)
{
    <p class="error" role="alert">@error</p>
}

@if (models.Length == 0 && error is null)
{
    <p class="muted">Henüz model yok. Lab ilk açıldığında seed genomdan oluşur.</p>
}

<p class="toolbar">
    <label class="chip"><input type="checkbox" @bind="showArchived" /> Arşivlenenleri göster</label>
    <span class="tabs" role="group" aria-label="Görünüm">
        <button class="@(listView ? null : "active")" @onclick="() => listView = false">Kart</button>
        <button class="@(listView ? "active" : null)" @onclick="() => listView = true">Liste</button>
    </span>
    <span class="muted">En yeni üstte · @Visible.Count() model</span>
</p>

@if (listView)
{
    <table class="model-list">
        <thead><tr><th>Model</th><th>Durum</th><th>Genom</th><th>Puan</th><th>Oluşturuldu</th><th></th></tr></thead>
        <tbody>
            @foreach (var m in Visible)
            {
                <tr>
                    <td><a class="link" href="@($"evrim/{m.Name}")">@m.Name</a></td>
                    <td><span class="state">@m.Active</span></td>
                    <td><code>@m.ActiveId</code></td>
                    <td>@(m.Fitness is { } f ? f.ToString("0.###") : "—")</td>
                    <td class="muted">@(m.Created is { } c ? c.LocalDateTime.ToString("dd.MM HH:mm") : "—")</td>
                    <td><button class="ghost" aria-expanded="@open.Contains(m.Name)" @onclick="() => ToggleAsync(m)">@(open.Contains(m.Name) ? "Gizle" : "Ayrıntı")</button></td>
                </tr>
                @if (open.Contains(m.Name))
                {
                    <tr><td colspan="6">@DetailView(m)</td></tr>
                }
            }
        </tbody>
    </table>
}
else
{
    <div class="grid">
        @foreach (var m in Visible)
        {
            <article class="card">
                <header>
                    <h2><a class="link" href="@($"evrim/{m.Name}")">@m.Name</a></h2>
                    <span class="state">@m.Active</span>
                </header>
                <p>Aktif genom: <code>@m.ActiveId</code>@(m.Fitness is { } f ? $" · puan {f:0.###}" : "")</p>
                <p class="muted">@m.Versions genom sürümü · @m.Campaigns evrim kampanyası (@m.Running sürüyor)@(m.Created is { } c ? $" · {c.LocalDateTime:dd.MM HH:mm}" : "")</p>
                <p class="muted">@(m.Robots == 0 ? "Fiziksel robot yok: tüm çalışma simülasyonda." : $"{m.Robots} fiziksel robot")</p>
                <button class="ghost" aria-expanded="@open.Contains(m.Name)" @onclick="() => ToggleAsync(m)">@(open.Contains(m.Name) ? "Ayrıntıyı gizle" : "Ayrıntı")</button>
                @if (open.Contains(m.Name)) { @DetailView(m) }
                <a class="primary" href="@($"evrim/{m.Name}")">Aç: 3B tasarım, iç aksam, evrim ve eğitim</a>
                @if (m.Active != "aktif")
                {
                    <button class="ghost" disabled="@busyModel.Equals(m.Name)" @onclick="() => ArchiveAsync(m.Name)">Arşivle</button>
                }
            </article>
        }
    </div>
}

@if (robots.Length > 0)
{
    <h2>Robotlar</h2>
    <div class="grid">
        @foreach (var r in robots)
        {
            <article class="card">
                <header><a class="link" href="@($"robotlar/{r.Id}")">@r.Id</a><span class="state">@r.State</span></header>
                <p class="muted">Model: <a class="link" href="@($"evrim/{ModelOf(r.GenomeId)}")">@ModelOf(r.GenomeId)</a> · genom @r.GenomeId</p>
            </article>
        }
    </div>
}

@code {
    private sealed record ModelCard(string Name, string Active, string ActiveId, double? Fitness, int Versions, int Campaigns, int Running, int Robots, DateTimeOffset? Created);

    // what the lazy details show: counted from the model's scene only when the row is opened (nothing is fetched for closed rows)
    private sealed record Detail(int Parts, int Printed, int Bought, int FitIssues, bool Generated, string[] Groups);

    private readonly HashSet<string> open = [];
    private readonly Dictionary<string, Detail?> details = [];
    private readonly HashSet<string> loading = [];
    private bool listView;

    private IEnumerable<ModelCard> Visible => models.Where(m => showArchived || m.Active != "deprecated");

    private async Task ToggleAsync(ModelCard m)
    {
        if (!open.Add(m.Name)) { open.Remove(m.Name); return; }
        if (details.ContainsKey(m.Name)) { return; }
        loading.Add(m.Name);
        try
        {
            if (await Api.GetModelSceneAsync(m.ActiveId) is { } sc)
            {
                var bom = sc.TryGetProperty("bom", out var b) && b.ValueKind == System.Text.Json.JsonValueKind.Array ? b.EnumerateArray().ToList() : [];
                var groups = bom.Select(r => r.TryGetProperty("group", out var g) ? g.GetString() ?? "" : "").GroupBy(g => g).Select(g => $"{g.Key}: {g.Count()}").ToArray();
                var fit = sc.TryGetProperty("fit", out var f) && f.TryGetProperty("issues", out var iss) && iss.ValueKind == System.Text.Json.JsonValueKind.Array ? iss.GetArrayLength() : 0;
                var parts = sc.TryGetProperty("parts", out var p) && p.ValueKind == System.Text.Json.JsonValueKind.Array ? p.GetArrayLength() : 0;
                details[m.Name] = new Detail(parts, bom.Count(r => r.TryGetProperty("group", out var g) && (g.GetString() ?? "").StartsWith("Basılı")),
                    bom.Count(r => r.TryGetProperty("group", out var g) && (g.GetString() ?? "").StartsWith("Satın")), fit,
                    sc.TryGetProperty("generated", out var gen) && gen.ValueKind == System.Text.Json.JsonValueKind.True, groups);
            }
            else { details[m.Name] = null; }
        }
        catch (HttpRequestException) { details[m.Name] = null; }
        finally { loading.Remove(m.Name); }
    }

    private Microsoft.AspNetCore.Components.RenderFragment DetailView(ModelCard m) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "muted");
        builder.AddContent(2, loading.Contains(m.Name) ? "Yükleniyor…"
            : details.GetValueOrDefault(m.Name) is { } d
                ? $"{d.Parts} 3B parça · {d.Printed} basılı, {d.Bought} satın alınan kalem · yerleşim sorunu {d.FitIssues}"
                    + (d.Generated ? " · lab tasarımı (simülasyonda kendi gövdesiyle çalışır)" : "")
                    + (d.Groups.Length > 0 ? " · " + string.Join(", ", d.Groups) : "")
                : "Bu modelin 3B sahnesi henüz hazır değil.");
        builder.CloseElement();
    };

    private void Open(string mode)
    {
        Assistant.Mode = mode;
        Assistant.Open = true;
        Assistant.Notify();
    }

    private static readonly (string, string)[] Templates =
    [
        ("Gezgin robot", "Hobi bahçesinde dolaşan, 3 kg altı, dört tekerlekli küçük gezgin robot"),
        ("Dört bacaklı yürüyen robot", "Engebeli arazide yürüyen, 12 servolu, dört bacaklı küçük robot"),
        ("Robot kol", "Masa üstünde çalışan, 4 eksenli, tutucu uçlu küçük robot kol"),
    ];
    private string? created;

    private async Task CreateAsync(string title, string brief)
    {
        busyModel = title;
        try
        {
            await Api.LearnOpAsync(new { op = "design", brief });
            created = $"{title}: tasarım başladı (Öğrenme sayfasında ilerler).";
        }
        catch (HttpRequestException)
        {
            error = "İstek gönderilemedi.";
        }
        finally
        {
            busyModel = "";
        }
    }

    private bool showArchived;
    private string busyModel = "";

    /// <summary>Hides a model's drafts and tests (never an active design).</summary>
    private async Task ArchiveAsync(string name)
    {
        busyModel = name;
        try
        {
            var accepted = await Api.ArchiveModelAsync(name);
            for (var i = 0; i < 40; i++)
            {
                await Task.Delay(1000);
                var status = await Api.GetCommandAsync(accepted!.CommandId);
                if (status is null || status.State is "pending" or "delivered") { continue; }
                if (status.State == "applied") { await OnInitializedAsync(); }
                else { error = status.Result is { ValueKind: System.Text.Json.JsonValueKind.Object } e && e.TryGetProperty("error", out var why) ? why.GetString() : "Arşivlenemedi."; }
                break;
            }
        }
        catch (HttpRequestException)
        {
            error = "İstek gönderilemedi.";
        }
        finally
        {
            busyModel = "";
        }
    }

    private ModelCard[] models = [];
    private Robot[] robots = [];
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var tree = await Api.GetGenomeTreeAsync();
            var campaigns = await Api.GetCampaignsAsync();
            robots = await Api.GetRobotsAsync() ?? [];
            var first = tree.Select(n => n.Name).FirstOrDefault();
            models = [.. tree.GroupBy(n => n.Name).Select(g =>
            {
                var all = g.SelectMany(Flatten).ToList();
                var active = all.FirstOrDefault(n => n.Status == "active") ?? all.LastOrDefault(n => n.Status is "draft" or "testing") ?? all[0];
                var mine = campaigns.Where(c => ModelOfCampaign(c, first) == g.Key).ToList();
                return new ModelCard(g.Key, active.Status == "active" ? "aktif" : active.Status, active.Id, active.FitnessScore,
                    all.Count, mine.Count, mine.Count(c => c.State == "active"), robots.Count(r => ModelOf(r.GenomeId) == g.Key),
                    all.Max(n => n.CreatedAt));
            }).OrderByDescending(m => m.Created ?? DateTimeOffset.MinValue)];
        }
        catch (HttpRequestException)
        {
            error = "Modeller alınamadı.";
        }
    }

    private static IEnumerable<GenomeNode> Flatten(GenomeNode n) =>
        new[] { n }.Concat(n.Children.SelectMany(Flatten));

    internal static string ModelOf(string? genomeId) => genomeId?.Split('@')[0] ?? "";

    internal static string ModelOfCampaign(Campaign c, string? defaultModel) =>
        c.Budget is { ValueKind: System.Text.Json.JsonValueKind.Object } b && b.TryGetProperty("model", out var m) && m.GetString() is { Length: > 0 } name
            ? name
            : defaultModel ?? "";
}
