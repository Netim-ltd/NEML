# Copy to .env on the control server; replace every example/CHANGEME value.
NEML_DOCKERHUB_NAMESPACE=replace-me
NEML_IMAGE_TAG=1.0
NEML_BIND_IP=127.0.0.1
NEML_ENV=lab
NEML_DB_URL=postgresql+asyncpg://neml:CHANGEME@db.example.invalid:5432/neml?sslmode=verify-full
NEML_VLLM_URL=https://llm.example.invalid/v1
NEML_EMBED_URL=https://embed.example.invalid
NEML_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct-AWQ
NEML_CLOUD_WS=wss://api.neml.example.com/bridge/ws
NEML_NODE_ID=neml-control-01
NEML_API_KEY=CHANGEME
# Comma-separated owner identities allowed to approve level 4 physical changes.
NEML_OWNERS=
NEML_TENANT_ID=replace-me
NEML_TRAINING_EXPORT_KEY=CHANGEME
NEML_OPERATION_ROUTES={}
# Enable only after a candidate adapter is approved and the GPU service has TLS.
# NEML_OPERATION_ROUTES={"field/maintenance-triage":{"url":"https://gpu.example.invalid/v1/operation/generate","adapter_sha256":"64_HEX_CHARACTERS"}}
# NEML_OPERATION_SERVICE_KEY=CHANGEME
# NEML_OPERATION_CLIENT_KEY=CHANGEME
NEML_MODEL_SIGNING_SEED=CHANGEME
NEML_MCP_URL_FREECAD=https://lab.example.invalid/freecad/mcp
NEML_MCP_URL_KICAD=https://lab.example.invalid/kicad/mcp
NEML_MCP_URL_SIM=https://lab.example.invalid/sim/mcp
NEML_MCP_URL_FAB=https://lab.example.invalid/fab/mcp
NEML_MCP_URL_GENOME=https://lab.example.invalid/genome/mcp
NEML_MCP_URL_POSTGRES=https://lab.example.invalid/postgres/mcp
NEML_MCP_URL_FILESYSTEM=https://lab.example.invalid/filesystem/mcp
NEML_MCP_URL_GIT=https://lab.example.invalid/git/mcp
NEML_MCP_URL_BLENDER=https://lab.example.invalid/blender/mcp
# Enable the edge profile only after installing a trusted cert and key.
# NEML_LAB_BIND_IP=192.168.1.10
# NEML_TLS_CERT_FILE=/srv/neml/secrets/lab.crt
# NEML_TLS_KEY_FILE=/srv/neml/secrets/lab.key
