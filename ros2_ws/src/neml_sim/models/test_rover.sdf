<?xml version="1.0"?>
<!--
  Copyright (c) 2026 Mustafa Gulsoy.
  SPDX-License-Identifier: AGPL-3.0-or-later

  test_rover - a 2-wheel differential-drive stand-in used to exercise the sim
  server end to end without the quadruped URDF (which needs xacro/ROS).
  Drive it with: gz topic -t /model/<name>/cmd_vel -m gz.msgs.Twist -p "linear:{x:0.5}"
-->
<sdf version="1.10">
  <model name="test_rover">
    <link name="base_link">
      <pose>0 0 0.1 0 0 0</pose>
      <inertial><mass>2.0</mass>
        <inertia><ixx>0.02</ixx><iyy>0.04</iyy><izz>0.05</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c"><geometry><box><size>0.4 0.2 0.08</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 0.2 0.08</size></box></geometry></visual>
      <sensor name="cam" type="camera">
        <pose>0.2 0 0.05 0 0 0</pose>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <camera><horizontal_fov>1.2</horizontal_fov>
          <image><width>160</width><height>120</height></image>
          <clip><near>0.05</near><far>20</far></clip></camera>
      </sensor>
    </link>
    <link name="left_wheel">
      <pose>0 0.12 0.1 -1.5708 0 0</pose>
      <inertial><mass>0.2</mass>
        <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0008</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry></visual>
    </link>
    <link name="right_wheel">
      <pose>0 -0.12 0.1 -1.5708 0 0</pose>
      <inertial><mass>0.2</mass>
        <inertia><ixx>0.0005</ixx><iyy>0.0005</iyy><izz>0.0008</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.04</length></cylinder></geometry></visual>
    </link>
    <link name="caster">
      <pose>-0.17 0 0.05 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="c"><geometry><sphere><radius>0.05</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface></collision>
      <visual name="v"><geometry><sphere><radius>0.05</radius></sphere></geometry></visual>
    </link>
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="caster_joint" type="ball"><parent>base_link</parent><child>caster</child></joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.24</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
    </plugin>
  </model>
</sdf>
