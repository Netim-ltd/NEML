<!--
  rough_terrain - a baked 12x6 tile field, 5-45 mm relief.

  NEML_SPEC.md SS11.1 physics contract, identical in all five worlds:
    engine            DART
    max_step_size     0.001 s
    real_time_factor  0  (run as fast as the machine allows)

  SS11.2 determinism: nothing here fetches a model from Fuel and nothing here
  is randomised at load time. The geometry is baked in, so the world file
  sha256 that goes into `sim_version` actually describes what was simulated.

  Surface friction is the SS11.4 nominal 0.7; the run harness randomises it
  +-15% from the run seed, it is never edited in this file.
-->
<sdf version="1.10">
  <world name="rough_terrain">

    <physics name="dart_1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-dartsim-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="NemlSystem" name="neml::NemlSystem"/>
    <!-- T-034: config/gz_bridge.yaml maps /world/<world>/model/<ns>/joint_state
         to /<ns>/telemetry/joint_states. Without this system that topic has no
         publisher and the encoder half of the bridge carries nothing. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rough terrain as a baked grid of tiles, not a heightmap: a heightmap
         needs a PNG, a PNG is a git-lfs object, and an lfs object that fails
         to fetch turns a regression run into a silent flat-ground run. The
         tile heights below were drawn once from seed 20260208 and frozen.
         ponytail: swap for a real heightmap only if a gait starts overfitting
         to this tile lattice. -->
    <model name="tile_0_0">
      <static>true</static>
      <pose>0.300 -0.750 0.020 0 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.290 0.290 0.039</size></box></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.290 0.290 0.039</size></box></geometry>
          <material>
            <ambient>0.38 0.34 0.30 1</ambient>
            <diffuse>0.38 0.34 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
