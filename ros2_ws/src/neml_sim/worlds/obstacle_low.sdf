<!--
  obstacle_low - low steps at and above the M3_step height.

  NEML_SPEC.md SS11.1 physics contract, identical in all five worlds:
    engine            DART
    max_step_size     0.001 s
    real_time_factor  0  (run as fast as the machine allows)

  SS11.2 determinism: nothing here fetches a model from Fuel and nothing here
  is randomised at load time. The geometry is baked in, so the world file
  sha256 that goes into `sim_version` actually describes what was simulated.

  Surface friction is the SS11.4 nominal 0.7; the run harness randomises it
  +-15% from the run seed, it is never edited in this file.
-->
<sdf version="1.10">
  <world name="obstacle_low">

    <physics name="dart_1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-dartsim-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="NemlSystem" name="neml::NemlSystem"/>
    <!-- T-034: config/gz_bridge.yaml maps /world/<world>/model/<ns>/joint_state
         to /<ns>/telemetry/joint_states. Without this system that topic has no
         publisher and the encoder half of the bridge carries nothing. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 40 mm steps: the exact obstacle height of M3_step (SS11.3). -->
    <model name="step_0">
      <static>true</static>
      <pose>1.000 0.000 0.020 0 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.300 0.600 0.040</size></box></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.300 0.600 0.040</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.40 1</ambient>
            <diffuse>0.35 0.35 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="step_1">
      <static>true</static>
      <pose>2.000 0.250 0.020 0 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.300 0.600 0.040</size></box></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.300 0.600 0.040</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.40 1</ambient>
            <diffuse>0.35 0.35 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="step_2">
      <static>true</static>
      <pose>3.000 -0.250 0.020 0 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.300 0.600 0.040</size></box></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.300 0.600 0.040</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.40 1</ambient>
            <diffuse>0.35 0.35 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="step_3">
      <static>true</static>
      <pose>4.000 0.000 0.020 0 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.300 0.600 0.040</size></box></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.300 0.600 0.040</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.40 1</ambient>
            <diffuse>0.35 0.35 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- 80 mm kerb: above the nominal step, used as a failure case. -->
    <model name="kerb">
      <static>true</static>
      <pose>5.200 0.000 0.040 0 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.200 1.200 0.080</size></box></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.200 1.200 0.080</size></box></geometry>
          <material>
            <ambient>0.50 0.30 0.25 1</ambient>
            <diffuse>0.50 0.30 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
