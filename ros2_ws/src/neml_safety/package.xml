<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neml_safety</name>
  <version>0.1.0</version>
  <description>L1 (yazilim) guvenlik mandali ve watchdog izleyicisi (NEML_SPEC.md SS5.1, T-074). L0 donanim rolesinin yerine GECMEZ.</description>
  <maintainer email="mustafa.gulsoy@neml.local">Mustafa Gulsoy</maintainer>
  <license>AGPL-3.0-or-later</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>neml_msgs</depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <!-- neml_bringup is used by the launch tests but cannot be declared: bringup
       exec_depends on this package and colcon rejects the cycle. Build the whole
       workspace before colcon test. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
