# Copy to .env and replace every CHANGEME. Never commit .env.
POSTGRES_PASSWORD=CHANGEME
POSTGRES_RO_PASSWORD=CHANGEME
NEML_ENV=lab
NEML_MODEL=Qwen3-Coder-30B-A3B-Instruct-Q4_K_M
NEML_WORK_DIR=/srv/neml/work
NEML_ARTIFACT_DIR=/srv/neml/artifacts
NEML_OUTBOX_DB=/var/lib/neml/outbox.db
HF_TOKEN=unused-on-cpu-host
NEML_CLOUD_WS=ws://api:8080/bridge/ws
NEML_NODE_ID=lab-01
NEML_API_KEY=CHANGEME
NEML_OWNERS=
PRUSALINK_URL=http://127.0.0.1:1
PRUSALINK_API_KEY=unused
PRUSASLICER_BIN=/bin/true
PRUSA_GCODEVIEWER_BIN=/bin/true
# 64 hex characters (32-byte Ed25519 seed)
NEML_MODEL_SIGNING_SEED=CHANGEME
# --- cloud side (API + web app) ---
NEML_JWT_KEY=CHANGEME_32_CHARS_OR_MORE
NEML_PUBLIC_URL=https://neml.example.com
NEML_OWNER_EMAIL=owner@neml.local
NEML_OWNER_PASSWORD=CHANGEME
NEML_PANEL_URL=https://panel.neml.example.com
# Optional: a stronger hosted model (OpenAI-compatible) for the rule evolution and the round table only.
# Leave empty to keep everything on the local model. Rule text and design summaries are sent when set.
NEML_PROPOSER_URL=
NEML_PROPOSER_MODEL=
NEML_PROPOSER_KEY=
# OpenAI-compatible gateway for your other systems (RAG): comma separated keys, each 16+ characters; empty = refuses everything
NEML_GATEWAY_KEYS=
