{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neml.local/schemas/genome.schema.json",
  "title": "NEML Hardware Genome (NEML_SPEC.md 13.3)",
  "$comment": "Copyright (c) 2026 Mustafa Gulsoy. SPDX-License-Identifier: AGPL-3.0-or-later",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "genome_id",
    "hash",
    "parent",
    "created",
    "status",
    "morphology",
    "mechanical",
    "electronics",
    "power",
    "limits",
    "manufacturing"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "genome_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "parent": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z][a-z0-9_]*@[0-9a-f]{7,64}$" }
      ]
    },
    "created": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status": { "enum": ["draft", "testing", "active", "deprecated"] },

    "morphology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_type", "leg_count", "dof_per_leg", "total_dof"],
      "properties": {
        "body_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "leg_count": { "type": "integer", "minimum": 0, "maximum": 12 },
        "dof_per_leg": { "type": "integer", "minimum": 0, "maximum": 8 },
        "total_dof": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },

    "mechanical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material", "material_density_g_cm3", "body_mass_cad_kg"],
      "properties": {
        "material": { "enum": ["PETG", "PA6-CF", "PLA", "ASA", "TPU"] },
        "material_density_g_cm3": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "body_mass_kg": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 },
        "body_mass_cad_kg": { "type": "number", "exclusiveMinimum": 0, "maximum": 500 },
        "generated": {
          "description": "Set on robots the lab designed itself (LLM + CAD MCP): the request, the purpose and the plan of links.",
          "type": "object"
        },
        "imports": {
          "description": "Items imported from open-source repositories (parts, boards, a URDF summary) with their source and licence.",
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["id", "kind", "name", "source", "repo", "license"],
            "properties": {
              "id": { "type": "string", "pattern": "^(imp_[0-9a-f]{6}|gen)_[0-9a-z_]+$" },
              "kind": { "enum": ["stl", "step", "kicad", "urdf", "repo"] },
              "name": { "type": "string", "maxLength": 80 },
              "source": { "type": "string", "pattern": "^(https://github[.]com/|NEML)" },
              "repo": { "type": "string", "maxLength": 160 },
              "license": { "type": "string", "maxLength": 60 }
            }
          }
        },
        "layout": {
          "description": "Per-part placement overrides of the 3D model: absolute position and (proxy parts) box size in mm, keyed by scene part id.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pos": { "type": "array", "items": { "type": "number", "minimum": -600, "maximum": 600 }, "minItems": 3, "maxItems": 3 },
              "size": { "type": "array", "items": { "type": "number", "minimum": 1, "maximum": 600 }, "minItems": 3, "maxItems": 3 }
            }
          }
        }
      }
    },

    "electronics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compute", "motion_controller", "safety_mcu", "actuators", "sensors"],
      "properties": {
        "compute": { "$ref": "#/$defs/module" },
        "motion_controller": { "$ref": "#/$defs/module" },
        "aux_mcu": { "$ref": "#/$defs/module" },
        "safety_mcu": { "$ref": "#/$defs/module" },
        "actuators": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "count", "stall_torque_nm"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1, "maximum": 64 },
            "stall_torque_nm": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "sensors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "model"],
            "properties": {
              "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "model": { "type": "string", "minLength": 1 },
              "rate_hz": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
              "count": { "type": "integer", "minimum": 1, "maximum": 32 }
            }
          }
        }
      }
    },

    "power": {
      "type": "object",
      "additionalProperties": false,
      "required": ["battery", "bms", "rails"],
      "properties": {
        "battery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["chemistry", "cells", "capacity_mah", "c_rating"],
          "properties": {
            "chemistry": { "enum": ["lipo", "liion", "lifepo4", "nimh"] },
            "cells": { "type": "integer", "minimum": 1, "maximum": 12 },
            "capacity_mah": { "type": "integer", "minimum": 100, "maximum": 100000 },
            "c_rating": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }
          }
        },
        "bms": { "enum": ["required", "none"] },
        "rails": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["v", "a_max", "converter"],
            "properties": {
              "v": { "type": "number", "exclusiveMinimum": 0, "maximum": 48 },
              "a_max": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
              "converter": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "limits": {
      "$comment": "SPEC 13.3: closed to evolution, enforced in code, never widened by a candidate.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "joint_torque_nm_max",
        "joint_velocity_rads_max",
        "body_current_a_max",
        "body_temp_c_max"
      ],
      "properties": {
        "joint_torque_nm_max": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 },
        "joint_velocity_rads_max": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 },
        "body_current_a_max": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "body_temp_c_max": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 }
      }
    },

    "manufacturing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["print_time_h", "material_cost_try", "bom_cost_try", "assembly_time_h"],
      "properties": {
        "print_time_h": { "type": "number", "minimum": 0 },
        "material_cost_try": { "type": "number", "minimum": 0 },
        "bom_cost_try": { "type": "number", "minimum": 0 },
        "assembly_time_h": { "type": "number", "minimum": 0 }
      }
    },

    "performance": {
      "$comment": "SPEC 13.3: measured on hardware, not simulated.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_speed_mps", "endurance_min", "mtbf_h"],
      "properties": {
        "max_speed_mps": { "type": "number", "minimum": 0 },
        "endurance_min": { "type": "number", "minimum": 0 },
        "mtbf_h": { "type": "number", "minimum": 0 }
      }
    },

    "fitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "campaign", "weights_ref"],
      "properties": {
        "score": { "type": "number", "minimum": -1, "maximum": 1 },
        "campaign": { "type": "string", "pattern": "^campaign_[0-9]{3}$" },
        "weights_ref": { "type": "string", "minLength": 1 }
      }
    }
  },

  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "firmware": { "type": "string", "minLength": 1 }
      }
    }
  }
}
