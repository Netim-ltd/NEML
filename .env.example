# --- Lab ---
NEML_ENV=lab
NEML_DB_URL=postgresql+asyncpg://neml:CHANGEME@localhost:5432/neml_local
NEML_VLLM_URL=http://localhost:8000/v1
NEML_EMBED_URL=http://localhost:8081
NEML_MODEL=Qwen/Qwen2.5-Coder-1.5B-Instruct-AWQ
NEML_WORK_DIR=/srv/neml/work
NEML_ARTIFACT_DIR=/srv/neml/artifacts
NEML_OUTBOX_DB=/var/lib/neml/outbox.db
HF_TOKEN=CHANGEME

# --- Bridge ---
NEML_CLOUD_WS=wss://api.neml.example.com/bridge/ws
NEML_NODE_ID=lab-01
NEML_API_KEY=CHANGEME
# Comma-separated owner identities for level 4 physical deployment approvals.
# Keep empty until real owner accounts are provisioned; level 4 then fails closed.
NEML_OWNERS=

# --- Yazıcı ---
PRUSALINK_URL=http://192.168.1.50
PRUSALINK_API_KEY=CHANGEME
PRUSASLICER_BIN=/usr/bin/prusa-slicer
PRUSA_GCODEVIEWER_BIN=/usr/bin/prusa-gcodeviewer

# --- Uzak sunucu (.NET) ---
ConnectionStrings__Default=Host=localhost;Database=neml_cloud;Username=neml;Password=CHANGEME
Jwt__Issuer=neml
Jwt__Audience=neml-clients
Jwt__Key=CHANGEME_MIN_32_CHARS
Fcm__CredentialsPath=/etc/neml/fcm.json

# --- Docker compose ---
# §17.3 lists the variables the lab processes read. These five are read only by
# docker/compose.yml itself, so they extend §17.3 rather than contradict it;
# without POSTGRES_PASSWORD `docker compose up` refuses to start (§17.4 step 2).
POSTGRES_USER=neml
POSTGRES_DB=neml_local
POSTGRES_PASSWORD=CHANGEME
DOCKER_GID=999
NEML_EMBED_THREADS=8
# §6.1 #4 - neml-mcp-pg connects as the READ-ONLY role, never as `neml`.
# Create it with scripts/db/ before `docker compose up mcp-pg`.
POSTGRES_RO_USER=neml_ro
POSTGRES_RO_PASSWORD=CHANGEME
# Ed25519 private seed for signed edge model packages (64 hex characters).
# Generate outside the repository and store only in a secret manager or .env.
NEML_MODEL_SIGNING_SEED=CHANGEME
# Enable the optional edge TLS profile only after installing a trusted cert.
# NEML_LAB_BIND_IP=192.168.1.10
# NEML_TLS_CERT_FILE=/srv/neml/secrets/lab.crt
# NEML_TLS_KEY_FILE=/srv/neml/secrets/lab.key
